# Public Supabase configuration (exposed to the browser by design)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Privileged Supabase configuration (server-only; never commit a real value)
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Email provider and controlled delivery
RESEND_API_KEY=replace-with-server-only-resend-api-key
APPLICANT_EMAIL_DELIVERY_ENABLED=false
APPLICANT_EMAIL_TEST_RECIPIENT=approved-test-recipient@example.invalid
APPLICANT_EMAIL_FROM=Approved Sender <approved-sender@example.invalid>
INTERNAL_NOTIFICATION_RECIPIENT=approved-internal-recipient@example.invalid

# Future HQ-approved applicant delivery (unused while delivery is disabled)
APPLICANT_EMAIL_REPLY_TO=approved-reply-to@example.invalid

# Application security (independent random secret; never reuse another credential)
RATE_LIMIT_HASH_SECRET=replace-with-at-least-32-random-characters

# Proxy trust: leave empty on unrecognized platforms; approved value: cloudflare
TRUSTED_PROXY_PROVIDER=
