# Public Supabase configuration (exposed to the browser by design)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Cloudflare Turnstile (site key is public; secret and hostname allowlist are server-only)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
TURNSTILE_PROOF_SECRET=replace-with-independent-32-character-proof-secret
TURNSTILE_EXPECTED_HOSTNAMES=localhost,your-production-hostname.example
INFORMATION_RESPONSE_ENABLED=false
APPLICANT_PORTAL_ENABLED=false
APPLICANT_PORTAL_ACTIONS_ENABLED=false
APPLICANT_PORTAL_EMAIL_DELIVERY_ENABLED=false
APPLICANT_PORTAL_RECOVERY_ENABLED=false
APPLICATION_PUBLIC_URL=http://localhost:3000
APPLICANT_PORTAL_TEST_APPLICATION_REFERENCE=BKFC-GYM-REPLACE

# Privileged Supabase configuration (server-only; never commit a real value)
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Email provider and controlled delivery
RESEND_API_KEY=replace-with-server-only-resend-api-key
APPLICANT_EMAIL_DELIVERY_ENABLED=false
APPLICANT_COMMUNICATIONS_ENABLED=false
APPLICANT_COMMUNICATIONS_DRY_RUN=true
APPLICANT_COMMUNICATION_BATCH_SIZE=10
APPLICANT_COMMUNICATION_TOKEN_SECRET=replace-with-independent-32-character-secret
APPLICANT_EMAIL_TEST_RECIPIENT=approved-test-recipient@example.invalid
APPLICANT_EMAIL_FROM=Approved Sender <approved-sender@example.invalid>
INTERNAL_NOTIFICATION_RECIPIENT=approved-internal-recipient@example.invalid

# Future HQ-approved applicant delivery (unused while delivery is disabled)
APPLICANT_EMAIL_REPLY_TO=approved-reply-to@example.invalid

# Application security (independent random secret; never reuse another credential)
RATE_LIMIT_HASH_SECRET=replace-with-at-least-32-random-characters

# Proxy trust: leave empty on unrecognized platforms; approved value: cloudflare
TRUSTED_PROXY_PROVIDER=

# Secured Vercel Cron cleanup. Generate independent high-entropy values.
CRON_SECRET=replace-with-at-least-32-random-characters
# Start true, validate logs/counts, then explicitly switch to false.
APPLICATION_CLEANUP_DRY_RUN=true
APPLICATION_ABANDONED_SESSION_HOURS=24
APPLICATION_FAILED_SESSION_HOURS=24
APPLICATION_FINALIZED_SESSION_DAYS=30
APPLICATION_ANONYMOUS_USER_DAYS=7
APPLICATION_CLEANUP_BATCH_SIZE=50

# Frozen BKFC-EU v1 integration. Every direction defaults off and uses independent secrets.
BKFC_SUBMISSION_INTEGRATION_ENABLED=false
BKFC_PAYMENT_CALLBACK_ENABLED=false
BKFC_PAYMENT_REQUEST_DELIVERY_ENABLED=false
BKFC_INTEGRATION_ORPHAN_CLEANUP_ENABLED=false
BKFC_INTEGRATION_ORPHAN_CLEANUP_DRY_RUN=true
BKFC_INTEGRATION_ORPHAN_CLEANUP_BATCH_SIZE=50
BKFC_TO_EU_BEARER_SECRET_CURRENT=
BKFC_TO_EU_BEARER_SECRET_PREVIOUS=
EU_TO_BKFC_BEARER_SECRET_CURRENT=
EU_TO_BKFC_BEARER_SECRET_PREVIOUS=
BKFC_PAYMENT_REQUEST_BASE_URL=https://bkfc-backend.example.invalid
BKFC_CONSENT_NOTICE_VERSION_ALLOWLIST=

# v1.1 gym controls: keep disabled until coordinated staging approval.
BKFC_GYM_CONTROL_DELIVERY_ENABLED=false

# Optional public HTTPS destinations for the Gym Network email footer.
# Defaults use the official BKFC Gym Network and its footer policy pages.
GYM_NETWORK_EMAIL_URL=https://www.bkfc.com/gyms
GYM_NETWORK_EMAIL_PRIVACY_URL=https://www.bkfc.com/privacy-policy
GYM_NETWORK_EMAIL_TERMS_URL=https://www.bkfc.com/terms-of-use

# Official intake receipt queue only; workflow emails remain separately controlled.
BKFC_APPLICATION_RECEIPTS_MODE=disabled
BKFC_APPLICATION_RECEIPTS_TEST_REFERENCE=
